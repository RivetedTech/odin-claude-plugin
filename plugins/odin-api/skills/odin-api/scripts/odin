#!/usr/bin/env bash
#
# odin — thin authenticated curl wrapper for the Odin REST API.
#
# Reads the environment:
#   ODIN_API_TOKEN     (required)  the opat_ personal access token
#   ODIN_API_BASE_URL  (required)  backend origin, e.g. https://api.odinhelp.net
#   ODIN_TENANT_ID     (optional)  sent as X-Active-Tenant-Id
#
# Usage:
#   odin preflight                          # validate the token, print identity + expiry
#   odin GET    /api/tickets?pageSize=20
#   odin POST   /api/tickets '{"subject":"...","priority":"high"}'
#   odin PUT    /api/tickets/T1024 '{"status":"in_progress"}'
#   odin DELETE /api/profile/tokens/<tokenId>
#   odin --all GET /api/customers           # auto-follow every page, stream items
#
# The token is never echoed. Exits non-zero on any non-2xx response.
set -euo pipefail

die() { printf 'odin: %s\n' "$*" >&2; exit 2; }

case "${1:-}" in
  -h|--help|help)
    sed -n '3,20p' "$0"
    printf '%s\n' 'Options before the method: --body-file FILE, --idempotency-key KEY, --if-match VERSION'
    exit 0 ;;
esac

: "${ODIN_API_TOKEN:?set ODIN_API_TOKEN to your opat_ personal access token}"
: "${ODIN_API_BASE_URL:?set ODIN_API_BASE_URL (dev https://api.odinhelp.net, prod https://api.odinhelp.com)}"

BASE="${ODIN_API_BASE_URL%/}"
case "$BASE" in
  https://api.odinhelp.com|https://api.odinhelp.net) ;;
  *) die "use the verified HTTPS Odin API origin (api.odinhelp.com or api.odinhelp.net)" ;;
esac
for value in "$ODIN_API_TOKEN" "${ODIN_TENANT_ID:-}"; do
  [[ "$value" != *$'\n'* && "$value" != *$'\r'* ]] || die "invalid authentication header"
done

have_jq() { command -v jq >/dev/null 2>&1; }

# pretty <json> — print JSON, formatted via jq when available.
pretty() {
  if have_jq; then printf '%s' "$1" | jq . 2>/dev/null || printf '%s\n' "$1"
  else printf '%s\n' "$1"; fi
}

# Header args as an array so the token is never interpolated into a printed
# command line.
_headers=(
  -H "Authorization: Bearer ${ODIN_API_TOKEN}"
  -H "Accept: application/json"
)
[[ -n "${ODIN_TENANT_ID:-}" ]] && _headers+=(-H "X-Active-Tenant-Id: ${ODIN_TENANT_ID}")

# Stable write identity and optimistic concurrency. Options precede the method.
_body_file=""
while [[ "${1:-}" == --idempotency-key || "${1:-}" == --if-match || "${1:-}" == --body-file ]]; do
  [[ $# -ge 2 && -n "$2" ]] || die "$1 requires a value"
  [[ "$2" != *$'\n'* && "$2" != *$'\r'* ]] || die "invalid header value"
  case "$1" in
    --idempotency-key) _headers+=(-H "Idempotency-Key: $2") ;;
    --if-match) _headers+=(-H "If-Match: $2") ;;
    --body-file) [[ -f "$2" && -r "$2" ]] || die "body file must be a readable regular file"; _body_file="$2" ;;
  esac
  shift 2
done

# request METHOD PATH [BODY] — one call. Sets globals RESP_BODY and RESP_CODE.
RESP_BODY=""
RESP_CODE=""
request() {
  local method="$1" path="$2" body="${3:-}"
  [[ "$path" == /api/* && "$path" != *$'\n'* && "$path" != *$'\r'* && "$path" != *'#'* ]] || die "path must start with /api/ and contain no fragment or line break"
  local url="${BASE}${path}"
  local args=(-sS -X "$method" "${_headers[@]}")
  if [[ -n "$_body_file" ]]; then
    [[ "$method" == POST || "$method" == PUT || "$method" == PATCH ]] || die "--body-file requires POST, PUT or PATCH"
    [[ -z "$body" ]] || die "use either --body-file or an inline body"
    args+=(-H "Content-Type: application/json" --data-binary "@${_body_file}")
  elif [[ -n "$body" ]]; then
    args+=(-H "Content-Type: application/json" --data "$body")
  fi
  local raw
  raw="$(curl "${args[@]}" -w $'\n%{http_code}' "$url")"
  RESP_CODE="${raw##*$'\n'}"
  RESP_BODY="${raw%$'\n'*}"
  # API Gateway rejects unregistered paths before the live permission checks.
  if [[ "$RESP_CODE" == 403 && "$method" == GET && "${path%%\?*}" =~ ^/api/native-context/[^/]+/history$ ]]; then
    printf '%s\n' 'odin: Unregistered context history path. The documented route is GET /api/native-context/{id}?operation=history (follow nextCursor). This routing response does not establish permission to read history; no retry or permission change was made.' >&2
  fi
}

# jq read with a `.data.` (backend envelope) then top-level fallback.
_field() { printf '%s' "$RESP_BODY" | jq -r "$1" 2>/dev/null || true; }

cmd_preflight() {
  request GET "/api/profile/tokens/validate"
  if [[ "$RESP_CODE" != 2* ]]; then
    if [[ "$RESP_CODE" == 401 ]]; then
      printf 'INVALID — token missing, expired, or revoked (HTTP %s). Reissue it on your Profile.\n' "$RESP_CODE" >&2
    else
      printf 'odin: preflight failed (HTTP %s); inspect access and the response before reissuing a token.\n' "$RESP_CODE" >&2
    fi
    pretty "$RESP_BODY" >&2
    return 1
  fi
  if have_jq; then
    local email tenant days
    email="$(_field '.data.userEmail // .userEmail // "unknown"')"
    tenant="$(_field '.data.tenantId // .tenantId // "unknown"')"
    days="$(_field '.data.daysRemaining // .daysRemaining // empty')"
    if [[ -n "$days" ]]; then
      printf 'valid · %s · tenant %s · expires in %s days\n' "$email" "$tenant" "$days"
    else
      printf 'valid · %s · tenant %s\n' "$email" "$tenant"
    fi
  else
    printf 'valid (HTTP %s)\n' "$RESP_CODE"
  fi
}

cmd_request() {
  local method="$1" path="$2" body="${3:-}"
  request "$method" "$path" "$body"
  pretty "$RESP_BODY"
  [[ "$RESP_CODE" == 2* ]] || { printf 'odin: HTTP %s\n' "$RESP_CODE" >&2; return 1; }
}

# --all: GET every page, streaming each page's data items as NDJSON.
cmd_all() {
  local method="$1" path="$2"
  have_jq || die "--all requires jq"
  [[ "$method" == "GET" ]] || die "--all only supports GET"
  [[ ! "$path" =~ [\?\&]cursor= ]] || die "--all starts at the first page; omit cursor"
  local cursor="" sep="?" seen_cursors=$'\n'
  [[ "$path" == *\?* ]] && sep="&"
  while :; do
    local url_path="$path"
    if [[ -n "$cursor" ]]; then
      local encoded_cursor
      encoded_cursor="$(printf '%s' "$cursor" | jq -sRr @uri)"
      url_path="${path}${sep}cursor=${encoded_cursor}"
    fi
    request GET "$url_path"
    if [[ "$RESP_CODE" != 2* ]]; then
      printf 'odin: HTTP %s\n' "$RESP_CODE" >&2; pretty "$RESP_BODY" >&2; return 1
    fi
    # Do not silently treat malformed or missing page data as an empty result.
    local page_body="$RESP_BODY"
    [[ -n "$page_body" ]] || die "empty page response; retrieval is incomplete"
    local rows='(.data | if type == "array" then . elif type == "object" then (.items // .data) else null end)'
    printf '%s' "$page_body" | jq -ce "$rows | if type == \"array\" then .[] else error(\"not a paginated collection\") end" || {
      # jq exits 4 for an empty array; validate its shape separately.
      printf '%s' "$page_body" | jq -e "$rows | type == \"array\"" >/dev/null || return 1
    }
    cursor="$(_field '.data.nextCursor? // .nextCursor // empty')"
    if [[ -z "$cursor" && "$(_field '.data.partial? // .data.truncated? // false')" == true ]]; then
      die "partial result has no continuation cursor; retrieval is incomplete"
    fi
    [[ -n "$cursor" ]] || break
    [[ "$cursor" != *$'\n'* && "$cursor" != *$'\r'* ]] || die "invalid continuation cursor"
    [[ "$seen_cursors" != *$'\n'"$cursor"$'\n'* ]] || die "repeated continuation cursor; retrieval is incomplete"
    seen_cursors+="$cursor"$'\n'
  done
}

main() {
  [[ $# -ge 1 ]] || die "usage: odin preflight | odin <METHOD> <path> [json] | odin --all GET <path>"
  case "$1" in
    preflight) cmd_preflight ;;
    --all) shift; [[ $# -ge 2 ]] || die "usage: odin --all GET <path>"; cmd_all "$1" "$2" ;;
    GET|POST|PUT|PATCH|DELETE)
      [[ $# -ge 2 ]] || die "usage: odin $1 <path> [json]"
      cmd_request "$1" "$2" "${3:-}" ;;
    -h|--help|help) sed -n '3,20p' "$0" ;;
    *) die "unknown command '$1' (expected preflight, --all, or an HTTP method)" ;;
  esac
}

main "$@"
